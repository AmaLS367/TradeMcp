# ENCRYPTION_KEY: Required. 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_char_hex_key_here"

# FIREBASE_SERVICE_ACCOUNT_KEY: Required outside Google Cloud.
# Paste the contents of your Firebase service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# PORT: Optional. Defaults to 3000.
PORT=3000

# PUBLIC_BASE_URL: Required for OAuth redirects in production.
# Frontend will use VITE_PUBLIC_BASE_URL, backend uses PUBLIC_BASE_URL
PUBLIC_BASE_URL=http://localhost:3000
VITE_PUBLIC_BASE_URL=http://localhost:3000/api/mcp/

# OANDA API (Forex candles)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Twelve Data API (optional fallback candles)
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
