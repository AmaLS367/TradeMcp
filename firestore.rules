rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    match /users/{userId} {
      // User Profile Validation
      function isValidUser(data) {
        return data.keys().size() == 2 &&
               data.keys().hasAll(['email', 'createdAt']) &&
               data.email is string && data.email.size() <= 256 &&
               data.createdAt == request.time;
      }

      allow get: if isVerified() && request.auth.uid == userId;
      allow list: if false; // No blanket listing of users
      // Users can create their own profile, but cannot change it afterwards
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update, delete: if false;

      match /exchange_connections/{connectionId} {
        function isValidConnection(data) {
          return data.keys().size() == 5 &&
                 data.keys().hasAll(['provider', 'apiKeyEncrypted', 'apiSecretEncrypted', 'isActive', 'createdAt']) &&
                 data.provider is string && data.provider in ['binance', 'bybit'] &&
                 data.apiKeyEncrypted is string && data.apiKeyEncrypted.size() <= 1024 &&
                 data.apiSecretEncrypted is string && data.apiSecretEncrypted.size() <= 1024 &&
                 data.isActive is bool &&
                 data.createdAt == request.time;
        }
        function isValidConnectionUpdate(data) {
           // We only allow deleting or deactivating connection from client
           return data.isActive is bool;
        }

        allow read: if isVerified() && request.auth.uid == userId;
        allow create: if isVerified() && request.auth.uid == userId && isValidId(connectionId) && isValidConnection(incoming());
        // Only allow updating isActive. API keys must be re-created if changed.
        allow update: if isVerified() && request.auth.uid == userId && 
                         isValidConnectionUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isActive']);
        allow delete: if isVerified() && request.auth.uid == userId;
      }

      match /policies/{policyId} {
        function isValidPolicy(data) {
          return data.keys().size() == 5 &&
                 data.keys().hasAll(['maxOrderNotional', 'allowedSymbols', 'allowedActions', 'autoExecutionEnabled', 'updatedAt']) &&
                 data.maxOrderNotional is number &&
                 data.allowedSymbols is list && data.allowedSymbols.size() <= 100 &&
                 data.allowedActions is list && data.allowedActions.size() <= 10 &&
                 data.autoExecutionEnabled is bool &&
                 data.updatedAt == request.time;
        }

        allow read: if isVerified() && request.auth.uid == userId;
        // User can create or update their policy
        allow create: if isVerified() && request.auth.uid == userId && isValidId(policyId) && isValidPolicy(incoming());
        allow update: if isVerified() && request.auth.uid == userId && 
                         isValidPolicy(incoming()) && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['maxOrderNotional', 'allowedSymbols', 'allowedActions', 'autoExecutionEnabled', 'updatedAt']);
      }

      match /trade_proposals/{proposalId} {
        // Validation for user actions: users only approve or reject.
        // They cannot modify the actual proposal parameters.
        function isReviewAction() {
            return incoming().status in ['approved', 'rejected'] &&
                   existing().status == 'pending_approval' &&
                   incoming().approvedAt == request.time;
        }

        // The user can read their proposals.
        // Only the backend (Admin SDK) should create proposals.
        // Only the backend (Admin SDK) updates proposals to executed.
        allow read: if isVerified() && request.auth.uid == userId;
        
        allow update: if isVerified() && request.auth.uid == userId &&
          // Action: Review Proposal (Approve/Reject)
          (
             isReviewAction() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedAt'])
          );
          // Delete is forbidden from client, Create is forbidden from client.
      }

      match /audit_logs/{logId} {
        // Audit logs are read-only for the user. Written by Admin SDK.
        allow read: if isVerified() && request.auth.uid == userId;
      }

      match /tool_calls/{doc} {
        allow read: if isVerified() && request.auth.uid == userId;
      }

      match /order_events/{doc} {
        allow read: if isVerified() && request.auth.uid == userId;
        allow create: if isVerified() && request.auth.uid == request.resource.data.userId;
      }
    }

    match /alerts/{doc} {
      function isValidAlert(data) {
        return data.keys().hasAll(['userId', 'type', 'message', 'severity', 'count', 'resolved', 'createdAt', 'lastOccurred']) &&
               data.keys().hasOnly(['userId', 'type', 'provider', 'toolName', 'message', 'severity', 'count', 'lastOccurred', 'resolved', 'createdAt', 'resolvedAt']) &&
               data.userId == request.auth.uid &&
               data.type is string && data.type.size() <= 64 &&
               data.message is string && data.message.size() <= 1024 &&
               data.severity is string && data.severity.size() <= 32 &&
               data.count is number && data.count >= 0 &&
               data.resolved is bool &&
               (data.createdAt is string ? data.createdAt.size() <= 128 : data.createdAt is timestamp) &&
               (data.lastOccurred is string ? data.lastOccurred.size() <= 128 : data.lastOccurred is timestamp) &&
               (!('provider' in data) || (data.provider is string && data.provider.size() <= 128)) &&
               (!('toolName' in data) || (data.toolName is string && data.toolName.size() <= 128)) &&
               (!('resolvedAt' in data) || (data.resolvedAt is string ? data.resolvedAt.size() <= 128 : data.resolvedAt is timestamp));
      }

      allow read: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(doc) && isValidAlert(incoming());
      allow update: if isVerified() && isValidId(doc) && resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId && isValidAlert(incoming());
      allow delete: if isVerified() && resource.data.userId == request.auth.uid;
    }
  }
}
